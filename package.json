{
  "name": "lumino",
  "displayName": "Lumino",
  "version": "0.0.1",
  "description": "A Chrome extension built with Plasmo.",
  "author": "",
  "scripts": {
    "dev": "NODE_OPTIONS='--no-deprecation' plasmo dev",
    "build": "NODE_OPTIONS='--no-deprecation' plasmo build",
    "package": "NODE_OPTIONS='--no-deprecation' plasmo package",
    "test": "vitest run"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.65",
    "ai": "^6.0.190",
    "jszip": "^3.10.1",
    "marked": "^18.0.4",
    "plasmo": "0.90.5",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "turndown": "^7.2.4",
    "zod": "^4.4.3"
  },
  "manifest": {
    "permissions": [
      "storage",
      "history",
      "bookmarks",
      "sidePanel",
      "alarms",
      "tabs",
      "downloads",
      "scripting"
    ],
    "host_permissions": [
      "<all_urls>"
    ]
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.1.1",
    "@types/chrome": "0.0.258",
    "@types/node": "20.11.5",
    "@types/react": "18.2.48",
    "@types/react-dom": "18.2.18",
    "jsdom": "^29.1.1",
    "prettier": "3.2.4",
    "typescript": "5.3.3",
    "vitest": "^4.1.5"
  },
  "pnpm": {
    "overrides": {
      "zod": "3.25.76"
    }
  }
}
