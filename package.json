{
  "name": "lumino",
  "displayName": "Lumino: From Chat to Done — Connect Browser to Your Work.",
  "version": "1.0.0",
  "description": "A free AI assistant for deep research, knowledge management, web replication, browser automation, etc. — powered by your own LLM.",
  "author": "the invulnus",
  "scripts": {
    "dev": "NODE_OPTIONS='--no-deprecation' plasmo dev",
    "build": "NODE_OPTIONS='--no-deprecation' plasmo build",
    "package": "NODE_OPTIONS='--no-deprecation' plasmo package",
    "test": "vitest run"
  },
  "dependencies": {
    "dompurify": "^3.2.4",
    "jszip": "^3.10.1",
    "marked": "^18.0.4",
    "plasmo": "0.90.5",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "turndown": "^7.2.4",
    "zod": "3.25.76"
  },
  "manifest": {
    "permissions": [
      "storage",
      "sidePanel",
      "alarms",
      "tabs",
      "downloads",
      "scripting"
    ],
    "host_permissions": [
      "<all_urls>"
    ]
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.1.1",
    "@types/chrome": "0.0.258",
    "@types/dompurify": "^3.2.0",
    "@types/node": "20.11.5",
    "@types/react": "18.2.48",
    "@types/react-dom": "18.2.18",
    "jsdom": "^29.1.1",
    "prettier": "3.2.4",
    "typescript": "5.3.3",
    "vitest": "^4.1.5"
  }
}
