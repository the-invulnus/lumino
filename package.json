{
  "name": "lumino",
  "displayName": "Lumino",
  "version": "0.0.1",
  "description": "A Chrome extension built with Plasmo.",
  "author": "",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "package": "plasmo package",
    "test": "vitest run"
  },
  "dependencies": {
    "plasmo": "0.90.5",
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "manifest": {
    "permissions": [
      "storage",
        "history",
        "bookmarks",
      "sidePanel",
      "alarms",
      "tabs",
      "downloads",
      "scripting"
    ],
    "host_permissions": [
      "<all_urls>"
    ]
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.1.1",
    "@types/chrome": "0.0.258",
    "@types/node": "20.11.5",
    "@types/react": "18.2.48",
    "@types/react-dom": "18.2.18",
    "jsdom": "^29.1.1",
    "prettier": "3.2.4",
    "typescript": "5.3.3",
    "vitest": "^4.1.5"
  }
}
