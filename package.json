{
  "name": "lumino",
  "displayName": "Lumino - AI 网页助手、总结与笔记",
  "version": "1.1.1",
  "description": "浏览器侧边栏 AI 助手：总结网页、对比标签页、整理笔记与文件、执行网页任务。支持自选 AI 模型与 Obsidian 集成。",
  "author": "the invulnus",
  "scripts": {
    "dev": "NODE_OPTIONS='--no-deprecation' plasmo dev",
    "build": "NODE_OPTIONS='--no-deprecation' plasmo build",
    "package": "NODE_OPTIONS='--no-deprecation' plasmo build && cd build/chrome-mv3-prod && rm -f ../chrome-mv3-prod.zip && zip -rq ../chrome-mv3-prod.zip . && cd ../..",
    "test": "vitest run"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "dompurify": "^3.2.4",
    "jszip": "^3.10.1",
    "katex": "^0.18.1",
    "marked": "^18.0.4",
    "pdfjs-dist": "^3.11.174",
    "plasmo": "0.90.5",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "turndown": "^7.2.4",
    "zod": "3.25.76"
  },
  "manifest": {
    "name": "__MSG_extensionName__",
    "description": "__MSG_extensionDescription__",
    "default_locale": "zh_CN",
    "permissions": [
      "storage",
      "sidePanel",
      "alarms",
      "tabs",
      "downloads",
      "scripting",
      "offscreen"
    ],
    "host_permissions": [
      "<all_urls>"
    ],
    "web_accessible_resources": [
      {
        "resources": [
          "@mozilla/readability/Readability.js",
          "turndown/lib/turndown.browser.umd.js"
        ],
        "matches": [
          "<all_urls>"
        ]
      }
    ]
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.1.1",
    "@types/chrome": "0.0.258",
    "@types/dompurify": "^3.2.0",
    "@types/katex": "^0.16.8",
    "@types/node": "20.11.5",
    "@types/react": "18.2.48",
    "@types/react-dom": "18.2.18",
    "jsdom": "^29.1.1",
    "prettier": "3.2.4",
    "typescript": "5.3.3",
    "vitest": "^4.1.5"
  }
}
